{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "playload": [
        "./src/index.ts"
      ],
      "playload/react": [
        "./src/react.ts"
      ]
    }
  },
  "include": [
    "src",
    "demo",
    "scripts"
  ]
}
